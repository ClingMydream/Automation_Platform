page {
  min-height: 100%;
  background: #f6f8fc;
  color: #172033;
  font-size: 28rpx;
}

.page { padding: 32rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 24rpx rgba(32, 57, 100, .06); }
.primary-button { background: #1565c0; color: #fff; border-radius: 12rpx; font-size: 30rpx; }
.muted { color: #687385; }
.section-title { font-size: 34rpx; font-weight: 700; margin-bottom: 18rpx; }
.empty { text-align: center; padding: 100rpx 20rpx; color: #687385; }
