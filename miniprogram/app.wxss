page {
  min-height: 100%;
  background: #fff8fb;
  color: #4e3140;
  font-size: 28rpx;
}

.page { padding: 32rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 28rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 10rpx 28rpx rgba(224, 126, 159, .12); }
.primary-button { background: #ef7fa4; color: #fff; border-radius: 48rpx; font-size: 30rpx; box-shadow: 0 10rpx 18rpx rgba(239, 127, 164, .22); }
.muted { color: #a28691; }
.section-title { font-size: 34rpx; font-weight: 700; margin-bottom: 18rpx; }
.empty { text-align: center; padding: 100rpx 20rpx; color: #687385; }
