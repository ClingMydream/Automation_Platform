<view class="page login-page">
  <view class="brand">
    <view class="brand-mark">♡</view>
    <view>
      <view class="brand-title">莓好审批</view>
      <view class="brand-subtitle">把每一份申请，轻轻送到你手边</view>
    </view>
  </view>
  <view class="card form-card">
    <view class="flower">🎀</view>
    <view class="login-title">微信授权登录</view>
    <view class="muted login-copy">首次进入会自动创建小程序账号，由平台管理员统一管理权限。</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary-button" loading="{{loading}}" bindtap="wechatSignIn">微信一键登录</button>
    <view class="dev-divider">开发者工具体验</view>
    <input class="field" placeholder="体验昵称" value="{{displayName}}" bindinput="onInput" />
    <button class="dev-button" loading="{{loading}}" bindtap="devSignIn">进入体验模式</button>
  </view>
  <view class="tip">正式版本仅支持微信授权登录。体验模式只在开发环境开放。</view>
</view>
