<view class="page" wx:if="{{template}}"><view class="hero" style="background:{{template.color}}"><view>{{template.icon}}</view><view><view>{{template.name}}</view><text>{{template.description}}</text></view></view><view class="card"><block wx:for="{{template.fields}}" wx:key="key"><view wx:if="{{item.label}}" class="label">{{item.label}}<text wx:if="{{item.required}}"> *</text></view><picker wx:if="{{item.type==='select'}}" range="{{item.options}}" data-key="{{item.key}}" bindchange="pick"><view class="input">{{values[item.key] || '请选择'}}</view></picker><picker wx:elif="{{item.type==='date'}}" mode="date" data-key="{{item.key}}" bindchange="date"><view class="input">{{values[item.key] || '请选择日期'}}</view></picker><textarea wx:elif="{{item.type==='textarea'}}" class="textarea" placeholder="{{focusedKey === item.key ? '' : (item.placeholder || '请填写')}}" data-key="{{item.key}}" bindfocus="focus" bindblur="blur" bindinput="input"/><input wx:else class="input" placeholder="{{focusedKey === item.key ? '' : (item.placeholder || '请填写')}}" data-key="{{item.key}}" bindfocus="focus" bindblur="blur" bindinput="input"/></block><button class="primary-button submit" loading="{{loading}}" bindtap="submit">提交申请</button></view></view>
