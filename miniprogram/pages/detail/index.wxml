<view class="page" wx:if="{{item}}"><view class="card"><view class="title">{{item.template.icon}} {{item.title}}</view><view class="muted">{{item.request_no}}</view><view wx:for="{{item.template.fields}}" wx:key="key" class="line"><text>{{item.label}}</text><text>{{item.form_data[item.key]}}</text></view></view><view class="section-title">审批记录</view><view class="card" wx:for="{{item.actions}}" wx:key="created_at"><view>{{item.actor_name}} · {{item.action}}</view><view class="muted">{{item.comment}} {{item.created_at}}</view></view><view wx:if="{{item.status==='pending'}}" class="card"><textarea placeholder="审批意见（可选）" bindinput="input"/><button class="primary-button" data-action="approved" bindtap="decide">同意</button><button class="reject" data-action="rejected" bindtap="decide">拒绝</button></view></view>
