<view class="page"><view class="tabs"><view data-tab="mine" bindtap="setTab" class="{{active==='mine'?'active':''}}">我发起的</view><view data-tab="pending" bindtap="setTab" class="{{active==='pending'?'active':''}}">待我审批</view></view><view wx:if="{{!requests.length}}" class="empty">🌷 暂时没有审批记录</view><view wx:for="{{requests}}" wx:key="id" class="card request" data-id="{{item.id}}" bindtap="detail"><view class="request-top"><view>{{item.template.icon}} {{item.title}}</view><view class="tag {{item.status}}">{{item.status==='pending'?'审批中':item.status==='approved'?'已通过':'已拒绝'}}</view></view><view class="muted">{{item.request_no}} · {{item.created_at}}</view></view></view>
