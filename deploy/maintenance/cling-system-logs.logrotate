/var/log/messages
/var/log/secure
/var/log/cron
/var/log/maillog
/var/log/spooler
{
    daily
    rotate 14
    maxage 14
    maxsize 25M
    missingok
    notifempty
    compress
    dateext
    dateformat -%Y%m%d-%s
    create
    sharedscripts
    postrotate
        /usr/bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || exit 1
    endscript
}
